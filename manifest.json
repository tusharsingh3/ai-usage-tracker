{
  "manifest_version": 3,
  "name": "AI Usage Tracker",
  "version": "1.1",
  "description": "Tracks Claude and GitHub Copilot usage — limits, plan details, and reset times always visible.",
  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "host_permissions": ["https://claude.ai/*", "https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/settings/*"],
      "js": ["content_github.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Usage Tracker",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
